CREATE TABLE gempa (
	id INTEGER NOT NULL, 
	event_key VARCHAR(255) NOT NULL, 
	kategori VARCHAR(50) NOT NULL, 
	tanggal VARCHAR(50), 
	jam VARCHAR(20), 
	datetime DATETIME, 
	event_year INTEGER, 
	event_month INTEGER, 
	magnitude DECIMAL(3, 1), 
	kedalaman FLOAT, 
	latitude DECIMAL(9, 4), 
	longitude DECIMAL(9, 4), 
	wilayah VARCHAR(255), 
	lokasi_detail VARCHAR(500), 
	ai_status VARCHAR(100), 
	ai_rekomendasi VARCHAR(500), 
	source VARCHAR(100), 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, 
	PRIMARY KEY (id)
)


